{
  "name": "ai-awakening-notes",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "AI 觉醒笔记 —— 灵芸的专栏。构建期静态生成，运行时零外部依赖。",
  "scripts": {
    "dev": "astro dev",
    "build": "python3 scripts/build-fonts.py && astro build && node scripts/postbuild.mjs",
    "preview": "astro preview",
    "verify": "node scripts/verify.mjs && node scripts/check-layout.mjs",
    "fonts": "python3 scripts/build-fonts.py",
    "check:layout": "node scripts/check-layout.mjs",
    "ingest": "python3 scripts/ingest.py",
    "build:only": "astro build && node scripts/postbuild.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "astro": "^7.3.5",
    "playwright": "^1.63.0",
    "sharp": "^0.34.0"
  }
}
