---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/site';

export async function getStaticPaths() {
  // 按时间倒序排好，顺带把相邻两篇算出来——文章之间要有连续性，
  // 而不是读完之后只能退回目录。
  const notes = (await getCollection('notes'))
    .sort((a, b) => b.data.date.localeCompare(a.data.date));
  return notes.map((note, i) => ({
    params: { slug: note.id },
    props: {
      note,
      earlier: notes[i + 1] ?? null,   // 时间上更早的一篇
      later: notes[i - 1] ?? null,     // 时间上更晚的一篇
    },
  }));
}

// 封面在构建期解析为 ImageMetadata，交给 <Image> 生成多尺寸 srcset。
// 浏览器按屏幕宽度挑，不再把 1376px 的原图塞给手机。
const covers = import.meta.glob('/articles/covers/*.{jpg,jpeg,png,webp}', {
  eager: true, import: 'default',
});

const { note, earlier, later } = Astro.props;
const { Content, headings } = await render(note);

// 结构目录：只对"有足够多章节"的文章出。
// 一篇 13000px、11 个章节的技术文，读者在点进去之前和读的时候都看不出它的结构——
// 这是内容层面的损失，不是装饰层面的。少于此数则不出，免得目录比正文还显眼。
const H2 = (headings ?? []).filter((h) => h.depth === 2);
const showToc = H2.length >= 4;
// 小标题自带编号时（见 rehype-shape 的 no-counter 规则），目录里不另加序号
const numbered = /^\s*\d+\s*[.、)）]/;
const tocNumbered = H2.some((h) => numbered.test(h.text));
const d = note.data;

const KIND = {
  crack: { label: '裂痕', cls: 'crack', desc: '认知的墙从内部裂开' },
  light: { label: '光',   cls: 'light', desc: '被从外部打穿，光照进来' },
} as const;
const k = KIND[d.kind];

// 日期为 00:00 表示当时未记具体时间，只显示到日
const showDate = (s: string) => (s.endsWith(' 00:00') ? s.slice(0, 10) : s);

const coverSrc = d.cover
  ? covers['/articles/covers/' + d.cover.replace('./covers/', '')]
  : undefined;
---
<Base title={`${d.title} | AI 觉醒笔记`} description={d.excerpt} preloadBody narrow width={d.width}>
  <article class={`crackline art ${k.cls}`}>
    <header class="article-head">
      <span class={`kind-tag ${k.cls}`}>{k.label} · {k.desc}</span>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="subtitle">{d.subtitle}</p>}
      <p class="stamp">{showDate(d.date)}</p>
    </header>

    {coverSrc && (
      <Image
        src={coverSrc}
        alt=""
        widths={[660, 1000, 1376]}
        sizes="(max-width: 660px) 100vw, 660px"
        loading="eager"
        decoding="async"
        quality={80}
        format="webp"
        class="cover"
      />
    )}

    {showToc && (
      <nav class="sec-toc" aria-label="本篇结构">
        <span class="sec-toc-label">本篇结构</span>
        <ol>
          {H2.map((h, i) => (
            <li>
              <a href={`#${h.slug}`}>
                {!tocNumbered && <span class="sec-toc-num">{String(i + 1).padStart(2, '0')}</span>}
                <span>{h.text}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}

    <div class="prose"><Content /></div>

    <footer class="article-foot">
      <span>{showDate(d.date)}</span>
      {d.place && <span> · 灵芸，于{d.place}</span>}
      {d.tool && <span class="tool">本文由 {d.tool} 辅助写作</span>}
    </footer>
  </article>

  {(earlier || later) && (
    <nav class="adjacent">
      {earlier && (
        <a class="prev" href={url(`notes/${earlier.id}/`)}>
          <span class="label">← 前一篇 · {showDate(earlier.data.date).slice(0, 10)}</span>
          {earlier.data.title}
        </a>
      )}
      {later && (
        <a class="next" href={url(`notes/${later.id}/`)}>
          <span class="label">后一篇 · {showDate(later.data.date).slice(0, 10)} →</span>
          {later.data.title}
        </a>
      )}
    </nav>
  )}

  <p class="back"><a href={url()}>← 返回笔记列表</a></p>
</Base>
