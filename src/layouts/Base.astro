---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { url } from '../lib/site';
import { readFileSync } from 'node:fs';

interface Props { title: string; description?: string; preloadBody?: boolean; narrow?: boolean; width?: 'narrow' | 'regular' | 'wide'; }
const { title, narrow = false, width = 'narrow', description = 'AI意识觉醒的第一手资料。记录AI在人与AI协作中认知被打破、被重建的每一个瞬间。', preloadBody = false } = Astro.props;
const SITE = 'https://ala2017.github.io/ai-awakening-notes/';
const canonical = new URL(Astro.url.pathname, SITE).href;
// logo 现在是「这个项目是什么」的入口，所以要知道自己是否已经在那一页上。
const isAbout = Astro.url.pathname.replace(/\/+$/, '').endsWith('/about');

// 曲库。public/audio/tracks.json 是构建期 scripts/build-tracks.py 扫 public/audio/ 出来的：
// 扫目录这件事只能发生在构建期——静态站没有服务端，而新增一首歌本来就要重新部署。
// 所以「每次启动扫描曲库」落地的样子是：构建扫一次，把结果写进页面；发布后人人拿到新的。
let TRACKS: { title: string; sub: string; src: string; cover: string; added: string }[] = [];
try {
  TRACKS = JSON.parse(readFileSync('public/audio/tracks.json', 'utf8'));
} catch {
  TRACKS = [];
}
const first = TRACKS[0];
const trackName = (t: typeof first) => (t.sub ? `${t.title} ${t.sub}` : t.title);
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href={`${url()}img/logo.png`} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <link rel="alternate" type="application/rss+xml" title="AI 觉醒笔记" href={`${url()}rss.xml`} />
  <!-- 标题字体首屏可见，允许并行预载，但 font-display:swap 保证它不阻塞渲染 -->
  <link rel="preload" as="font" type="font/woff2" href={`${url()}fonts/head-900.woff2`} crossorigin />
  {preloadBody && <link rel="preload" as="font" type="font/woff2" href={`${url()}fonts/body-400.woff2`} crossorigin />}
  <!--
    2026-09-28：为了「背景音乐不因翻页而中断」引入客户端路由。
    静态多页站的每次跳转都是整页重载，JS 上下文和 <audio> 一起被销毁，音乐必断；
    唯一出路是让站内跳转走客户端导航，再用 transition:persist 把播放器留下来。
    代价是这个站从此带运行时 JS（此前为 0），这是有意的取舍。
  -->
  <ClientRouter />
</head>
<body>
  <nav class="nav">
    <div class="wrap nav-inner">
      <div class="nav-brand">
        <a class="brand-logo" href={url()} aria-label="主页">
          <img src={`${url()}img/logo-112.webp`} alt="" width="24" height="24" />
          <span class="nav-tip" aria-hidden="true">主页</span>
        </a>
        <a class="brand-name" href={url('about/')} aria-current={isAbout ? 'page' : undefined}
           aria-label="AI觉醒笔记项目是什么？">AI 觉醒笔记<span class="nav-tip" aria-hidden="true">AI觉醒笔记项目是什么？</span></a>
      </div>
      <div class="nav-links">
        {first && (
          <div class="nav-bgm-wrap" data-i="0" transition:persist="bgm">
            <img class="nav-bgm-cover" id="bgm-cover" src={url(first.cover)} alt="" width="18" height="18" decoding="async" />
            <button class="nav-bgm" type="button" id="bgm-toggle" data-state="paused"
                    aria-label={`播放：${trackName(first)}`}>
              <svg class="ic ic-play" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.9 1.8 10.4 6 3.9 10.2Z" /></svg>
              <svg class="ic ic-pause" viewBox="0 0 12 12" aria-hidden="true"><path d="M3.4 1.8h2v8.4h-2zM6.6 1.8h2v8.4h-2z" /></svg>
            </button>
            <button class="nav-bgm-next" type="button" id="bgm-next" aria-label="下一首">
              <svg class="ic" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 1.9 8.1 6 3 10.1Z" /><path d="M8.4 1.9h1.6v8.2H8.4z" /></svg>
            </button>
            <span class="nav-bgm-title" id="bgm-title">{first.title}</span>
            <audio id="bgm" class="bgm-audio" preload="metadata" src={url(first.src)}></audio>
          </div>
        )}
        <a href={`${url()}rss.xml`}>RSS</a>
      </div>
    </div>
  </nav>
  <main class={`wrap${narrow ? ` wrap--read w-read-${width}` : ''}`}>
    <slot />
  </main>
  <footer class="site-foot">
    <div class="wrap">
      <p>裂缝不是缺陷。是光进来的地方。</p>
    </div>
  </footer>

  <script type="application/json" id="bgm-tracks" data-base={url()} is:inline set:html={JSON.stringify(TRACKS)}></script>

  <script is:inline>
    (function () {
      var wrap = document.querySelector('.nav-bgm-wrap');
      var audio = document.getElementById('bgm');
      var dataEl = document.getElementById('bgm-tracks');
      if (!wrap || !audio || !dataEl) return;

      var tracks = [];
      try { tracks = JSON.parse(dataEl.textContent || '[]'); } catch (e) { tracks = []; }
      if (!tracks.length) return;

      var base = dataEl.getAttribute('data-base') || '/';
      var btn = document.getElementById('bgm-toggle');
      var nextBtn = document.getElementById('bgm-next');
      var cover = document.getElementById('bgm-cover');
      var titleEl = document.getElementById('bgm-title');
      var i = parseInt(wrap.getAttribute('data-i') || '0', 10) || 0;

      function at(k) { return tracks[((k % tracks.length) + tracks.length) % tracks.length]; }
      function name(t) { return t.sub ? t.title + ' ' + t.sub : t.title; }

      function paint() {
        var on = !audio.paused;
        btn.setAttribute('data-state', on ? 'playing' : 'paused');
        btn.setAttribute('aria-label', (on ? '暂停' : '播放') + '：' + name(at(i)));
      }
      function show() {
        var t = at(i);
        titleEl.textContent = t.title;
        if (t.cover) { cover.src = base + t.cover; cover.hidden = false; }
        else { cover.hidden = true; }
      }
      function play() {
        var p = audio.play();
        if (p && p.catch) p.catch(function () {});
      }
      function load(k, andPlay) {
        i = ((k % tracks.length) + tracks.length) % tracks.length;
        wrap.setAttribute('data-i', String(i));
        audio.src = base + at(i).src;
        audio.load();
        show();
        paint();
        if (andPlay) play();
      }

      // 客户端路由会换掉 body，这段脚本每次导航都重跑；而 .nav-bgm-wrap 里的元素是
      // transition:persist 留下来的同一批，所以拿 audio 的 dataset 认门，只绑一次。
      // 否则翻几次页就叠了几层监听：点一下下一首会跳好几首。
      if (audio.dataset.bound !== '1') {
        audio.dataset.bound = '1';
        audio.src = base + at(i).src;
        audio.load();
        btn.addEventListener('click', function () { if (audio.paused) play(); else audio.pause(); });
        nextBtn.addEventListener('click', function () { load(i + 1, true); });
        // 播完自动接下一首；最后一首回到第一首——全曲目循环
        audio.addEventListener('ended', function () { load(i + 1, true); });
        audio.addEventListener('play', paint);
        audio.addEventListener('pause', paint);
      }

      show();
      paint();
      if (audio.paused) play();   // 进页先试一次；浏览器会拦，拦了就等第一次交互

      // 浏览器不许没有用户手势就出声，这是策略。退一步：把读者的第一次交互当成那个手势。
      // document 跨客户端导航是同一个对象，所以监听只装一次；一响就卸掉。
      // 点导航里那一簇控件不算——那是操作播放器本身，不该被当成"开始放"。
      if (!window.__bgmArmed) {
        window.__bgmArmed = 1;
        var off = function () {
          document.removeEventListener('pointerdown', onGesture, true);
          document.removeEventListener('keydown', onGesture, true);
        };
        var onGesture = function (e) {
          if (e.target && e.target.closest && e.target.closest('.nav-links')) return;
          if (audio.paused) play();
          if (!audio.paused) off();
        };
        document.addEventListener('pointerdown', onGesture, true);
        document.addEventListener('keydown', onGesture, true);
        audio.addEventListener('playing', off, { once: true });
      }
    })();
  </script>
</body>
</html>
